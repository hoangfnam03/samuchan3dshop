{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shop",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-04",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/media/*"
		],
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "samuchan-catalog",
			"database_id": "6164ebb4-0ccf-4d42-9eba-73254317e040",
			"migrations_dir": "worker/migrations"
		},
		{
			"binding": "samuchan_catalog",
			"database_name": "samuchan-catalog",
			"database_id": "6164ebb4-0ccf-4d42-9eba-73254317e040",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "samuchan-media"
		},
		{
			"bucket_name": "samuchan-media",
			"binding": "samuchan_media",
			"remote": true
		}
	]
}
