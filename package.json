{
  "name": "samuchan-3d-shop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SAMUCHAN Gift & Custom — frontend and Cloudflare Worker MVP.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "worker:typecheck": "tsc -p tsconfig.worker.json --pretty false",
    "worker:dev": "wrangler dev --config wrangler.jsonc",
    "worker:d1:migrate": "wrangler d1 migrations apply samuchan-catalog --local --config wrangler.jsonc",
    "worker:d1:migrate:remote": "wrangler d1 migrations apply samuchan-catalog --remote --config wrangler.jsonc",
    "worker:d1:seed": "wrangler d1 execute samuchan-catalog --local --file=worker/seeds/local.sql --config wrangler.jsonc",
    "worker:d1:seed:remote": "wrangler d1 execute samuchan-catalog --remote --file=worker/seeds/local.sql --config wrangler.jsonc",
    "worker:admin:hash": "node scripts/hash-password.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "^8.3.5",
    "wrangler": "latest"
  }
}
